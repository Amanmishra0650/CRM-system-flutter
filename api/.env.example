NODE_ENV=development
DATABASE_URL=postgres://bike_rescue:change_me@localhost:5432/bike_rescue
JWT_SECRET=replace_with_long_random_secret_at_least_32_characters
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
# OTP_PROVIDER=console is permitted only with NODE_ENV=development. Production requires a real provider integration.
OTP_PROVIDER=console
# Set only for controlled initial admin setup; remove after bootstrap.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_SECRET=
# Optional payment gateway integration; do not use client payment success as proof.
PAYMENT_WEBHOOK_SECRET=
